# Core runtime. Render supplies PORT; local development defaults to 3000.
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SQLITE_PATH=data/app.db
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Production requires this explicit edge-proxy contract. Generate a high-entropy
# value (at least 32 characters) and configure the same value as a secret in a
# Cloudflare Transform Rule that overwrites/injects X-Edge-Proxy-Proof on every
# origin request. Configure the origin firewall to allow only Cloudflare; the
# application ignores direct-origin CF/XFF headers and never uses X-Forwarded-For.
TRUSTED_PROXY=
TRUSTED_PROXY_SECRET=

# Cloudflare Turnstile. Leave both blank to run forms keyless.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Access for /admin. Leave blank to keep admin closed (403).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated emails auto-provisioned as admins on first Access login.
# Anyone else Access admits still gets 403 until added here or to the admins table.
ADMIN_EMAILS=

# Resend-compatible transactional email.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Limits for retained verification/deletion and legacy modules. New appeal,
# support and response submissions stay disabled regardless of these values.
RATE_LIMIT_SUPPORT=5
RATE_LIMIT_VERIFY=10
RATE_LIMIT_PREVIEW=30
RATE_LIMIT_ACTION=30
RATE_LIMIT_RESPONSES=3

# Candidate directory: official 26th Knesset snapshots. This number selects the
# displayed election; it does not import or activate data. Automatic ETL stays off.
ELECTION_ETL_ENABLED=false
ELECTION_ETL_ELECTION_NUMBER=26
ELECTION_ETL_SCHEDULE_ENABLED=false
ELECTION_ETL_SOURCE_MANIFEST=
ELECTION_ETL_ARTIFACT_DIR=data/election-artifacts
# On Render, use /data/election-artifacts (see render.yaml and docs/ELECTION_DATA_OPERATIONS.md).

# Object storage (R2 / BACKUP_S3 / ERASURE_LEDGER_S3) is not part of the deploy
# contract. Persistence is the Render disk. New reply intake is paused;
# retain any existing storage credentials for historical attachment cleanup.
# Privacy deletion updates live SQLite without a remote ledger by default.
