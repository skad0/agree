# Core runtime. Render supplies PORT; local development defaults to 3000.
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SQLITE_PATH=data/app.db
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Required in production; set the operational email address for privacy questions,
# access, correction, and deletion. The marker below is development-only.
PRIVACY_CONTACT_EMAIL=[CAMPAIGN OPERATOR CONTACT TO BE ADDED BEFORE PRODUCTION]
# Production requires this explicit edge-proxy contract. Generate a high-entropy
# value (at least 32 characters) and configure the same value as a secret in a
# Cloudflare Transform Rule that overwrites/injects X-Edge-Proxy-Proof on every
# origin request. Configure the origin firewall to allow only Cloudflare; the
# application ignores direct-origin CF/XFF headers and never uses X-Forwarded-For.
TRUSTED_PROXY=cloudflare
TRUSTED_PROXY_SECRET=

# Cloudflare Turnstile. Leave both blank to run forms keyless.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Access for /admin. Leave blank to keep admin closed (403).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated emails auto-provisioned as admins on first Access login.
# Anyone else Access admits still gets 403 until added here or to the admins table.
ADMIN_EMAILS=

# Cloudflare R2 / S3-compatible response-file storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional custom S3 endpoint and signing region (R2 defaults to account URL / auto).
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=
# Optional response PUT timeout in milliseconds. Defaults to 30000; values above 30000 are capped.
RESPONSE_PUT_TIMEOUT_MS=30000

# Dedicated private S3-compatible erasure ledger, separate from response and
# backup stores. Keys use version:base64url-key pairs; retain old versions and
# select the active signer explicitly.
ERASURE_LEDGER_S3_ENDPOINT=
ERASURE_LEDGER_S3_ACCESS_KEY=
ERASURE_LEDGER_S3_SECRET_KEY=
ERASURE_LEDGER_S3_BUCKET=
ERASURE_LEDGER_S3_REGION=auto
ERASURE_LEDGER_HMAC_KEYS=
ERASURE_LEDGER_ACTIVE_KEY_VERSION=
ERASURE_LEDGER_PUT_TIMEOUT_MS=10000

# Resend-compatible transactional email.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# External S3-compatible SQLite backup bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto

# Optional per-IP limits; counts match docs/SPEC.md defaults.
RATE_LIMIT_SUPPORT=5
RATE_LIMIT_VERIFY=10
RATE_LIMIT_PREVIEW=30
RATE_LIMIT_ACTION=30
RATE_LIMIT_RESPONSES=3
